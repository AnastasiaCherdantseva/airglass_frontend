# Этап 1: Сборка
FROM node:18-alpine AS builder
WORKDIR /app
COPY package*.json .
 # чистая установка без dev-зависимостей(блок devDependencies в package.json)
RUN npm ci --only=production 
COPY . .

 # ← создает папку dist со статическими файлами
RUN npm run build 

# Этап 2: Сервер
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]